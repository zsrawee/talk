# Database
# For SQLite (local dev — run `npm run db:local` first):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (production / local):
# DATABASE_URL="postgresql://user:password@host:5432/talk"

# Auth.js (NextAuth v5) — generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-random-hex-string"
NEXTAUTH_SECRET="replace-with-random-hex-string"

# URLs
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
